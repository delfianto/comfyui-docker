# Build images and tags
IMAGE_NAME=ghcr.io/delfianto/comfyui-app
IMAGE_TAG=latest
BASE_IMAGE=ghcr.io/delfianto/comfyui-cuda:13.4.2-base-ubuntu26.04
CUDA_IMAGE=nvidia/cuda:13.4.2-base-ubuntu26.04

# Matched Torch/TorchVision/TorchAudio trio
TORCH_VERSION=2.11.0
TORCHVISION_VERSION=0.26.0
TORCHAUDIO_VERSION=2.11.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

# ComfyUI upstream repository
COMFYUI_REPOSITORY=https://github.com/Comfy-Org/ComfyUI.git

# Official local API proxy
IMAGE_PROXY_NAME=ghcr.io/delfianto/comfyui-proxy
PROXY_VERSION=0.1.6
